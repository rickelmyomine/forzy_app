# Copie este arquivo para ".streamlit/secrets.toml" (que NÃO deve ir para o Git)
# e cole sua chave da API do Gemini abaixo.
# Gere uma chave gratuita em: https://aistudio.google.com/app/apikey

GEMINI_API_KEY = "sua-chave-aqui"


MONGODB_URI = "mongodb+srv://usuario:senha@seu-cluster.mongodb.net/"
MONGODB_DB_NAME = "forzy_iot_db"

GMAIL_USER = "seuemail@gmail.com"
GMAIL_APP_PASSWORD = "senha-de-app"
# ---- Usuários do sistema (login) ----
[usuarios.gerente]
senha  = "1234"
nome   = "Gerente de Manutenção"
perfil = "gerente"

[usuarios.tecnico1]
senha  = "1234"
nome   = "Técnico 1"
perfil = "tecnico"

[usuarios.tecnico2]
senha  = "1234"
nome   = "Técnico 2"
perfil = "tecnico"

# ---- Alertas (e-mail / WhatsApp) ----
# Endereço público do app — usado nos QR Codes das placas das máquinas.
# Enquanto o app roda só no seu computador, deixe o localhost.
APP_URL = "http://localhost:8501"

ALERTA_TELEFONE = "(DD) 123456789"    # plantão exibido na tela de login
# Disparo automático para o Gerente de Manutenção quando a máquina fica
# em estado crítico por este tempo seguido (em minutos):
ALERTA_MINUTOS_CRITICOS = 30
ALERTA_AUTOMATICO = 1                 # 0 desliga o disparo automático
# WhatsApp automático (opcional — conta Twilio). Sem isso, o app gera o link wa.me:
# TWILIO_ACCOUNT_SID = "ACxxxxxxxx"
# TWILIO_AUTH_TOKEN  = "xxxxxxxx"
# TWILIO_WHATSAPP_FROM = "whatsapp:+14155238886"
